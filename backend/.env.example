# ============================================================================
# ⚠️ IMPORTANT: Copy this file to .env and fill in the values
# ============================================================================
# This file is NEVER committed to git for security reasons
# When you unzip the project, you MUST create a .env file with your own values
# ============================================================================

# ===== CRITICAL: MongoDB Connection String =====
# Without this, the app cannot save any data
# Get this from MongoDB Atlas: https://www.mongodb.com/cloud/atlas
# Format: mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/DATABASE
# Note: If your password has special characters (like @), URL encode them
#       Example: @ becomes %40, : becomes %3A
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/manual-rpm?retryWrites=true&w=majority

# ===== CRITICAL: JWT Secret (MUST BE 32+ CHARACTERS) =====
# This is used to sign authentication tokens for your users
# ❌ DO NOT USE THE EXAMPLE VALUE - Generate a random secret
# 
# Generate a new secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# ⚠️ SECURITY: If you change this after users have logged in, all existing tokens will be invalid
JWT_SECRET=your-random-32-character-secret-key-here-replace-with-random

# ===== Server Configuration =====
# How long tokens should be valid (don't change unless you know what you're doing)
JWT_EXPIRY=1h

# Which port the backend should run on (change only if 5001 is already in use)
PORT=5001

# Environment type (use 'development' during setup, 'production' for deployment)
NODE_ENV=development

# The URL where your frontend is running (for CORS - must match exactly)
# If frontend is on a different port, update this
FRONTEND_URL=http://localhost:5173

# ===== Optional: Email Configuration =====
# The app works fine without email, but reminders won't send notifications
# Only configure if you have a Gmail account with App Password enabled
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-specific-password
EMAIL_FROM="Manual-RPM Notifications" <your-email@gmail.com>
