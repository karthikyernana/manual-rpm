# ===== Backend API Configuration =====
# This is the URL where your backend API is running
# MUST match the backend PORT in backend/.env
# 
# Default setup (both running locally):
#   Frontend: http://localhost:5173
#   Backend: http://localhost:5001/api/v1
#
# If you change backend PORT, update this to match
# If you deploy backend to different URL, update this to point there
VITE_API_BASE_URL=http://localhost:5001/api/v1
